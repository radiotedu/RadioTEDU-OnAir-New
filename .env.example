# Environment variables for RadioTEDU Broadcast Room
# Copy this file to .env and customize values locally. Do not commit .env.

# Server configuration
CLEANROOM_HOST=127.0.0.1
CLEANROOM_PORT=8100

# Open browser panel automatically on startup (1=enable, 0=disable).
# Installed desktop builds normally launch the embedded shell instead.
CLEANROOM_OPEN_PANEL=1

# Database
# CLEANROOM_DB_PATH=C:\path\to\custom\cleanroom.db
# FULL is the default and prioritizes committed broadcast state over write speed.
# Allowed values: NORMAL, FULL, EXTRA.
RADIOTEDU_SQLITE_SYNCHRONOUS=FULL

# Security
JWT_SECRET_KEY=change-this-to-a-random-secret-key
# Optional path for the generated/persisted signing secret when JWT_SECRET_KEY is unset.
# CLEANROOM_JWT_SECRET_FILE=C:\ProgramData\MyRadio\jwt-secret
TRUST_PROXY_HEADERS=false
SECURITY_HEADERS_ENABLED=true

# CORS
# CORS_ORIGINS=http://localhost:8100,http://192.168.1.100:8100

# Public base URL for links in emails or reverse-proxy deployments.
# PUBLIC_BASE_URL=http://radio.example.com

# AI Host configuration
AI_HOST_ENABLED=1

# Pre-load AI models at server startup (1=enable, 0=disable).
# This can add startup time but makes AI responses faster after launch.
AI_PRELOAD_MODELS=true

# AI model paths. Leave empty to use bundled/default model locations.
# AI_LLM_MODEL=
# AI_TTS_MODEL_PATH=

# Voice persona preset. Examples: warm_radio_host, professional_announcer,
# casual_friend, energetic_morning, smooth_evening, classical_host, jazz_lounge,
# news_bulletin, or legacy values: morning, afternoon, evening, night.
# AI_VOICE_PRESET=warm_radio_host

# Custom AI prompt template. Leave empty to use the default.
# AI_PROMPT_TEMPLATE=

# Upload limits
# MAX_UPLOAD_BYTES=536870912

# WebRTC
WEBRTC_ENABLED=true
# WEBRTC_STUN_URL=stun:stun.l.google.com:19302
# WEBRTC_TURN_URL=
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=

# High availability (two broadcast nodes plus one witness)
# Enable only after following docs/HIGH_ASSURANCE_DEPLOYMENT.md.
CLEANROOM_HA_ENABLED=false
# CLEANROOM_HA_NODE_ID=onair-a
# Comma-separated URLs for the other broadcast node and witness.
# CLEANROOM_HA_PEERS=https://onair-b.internal:8100,https://onair-witness.internal:8110
# Use the same long random secret on the two nodes and witness; never commit it.
# CLEANROOM_HA_SHARED_SECRET=
# CLEANROOM_HA_FLOATING_IP=192.168.10.50
# CLEANROOM_HA_FLOATING_NETMASK=255.255.255.0
# CLEANROOM_HA_INTERFACE=Ethernet
CLEANROOM_HA_LEASE_SECONDS=6
CLEANROOM_HA_HEARTBEAT_SECONDS=1

# Independent media and recovery storage
# CLEANROOM_MEDIA_ROOT=E:\RadioTEDU Media
# CLEANROOM_RECORDING_MIRROR_ROOT=E:\RadioTEDU Recording Mirror
# Active stream changes are observed for 60 seconds before they become final.
CLEANROOM_STREAM_VERIFY_SECONDS=60
# CLEANROOM_DISABLE_RECOVERY_POINTS=0
