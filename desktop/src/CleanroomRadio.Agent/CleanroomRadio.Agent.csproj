<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CleanroomRadio.Desktop.Agent</RootNamespace>
    <ApplicationIcon>../../../app/static/icons/icon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CleanroomRadio.Desktop.Common/CleanroomRadio.Desktop.Common.csproj" />
  </ItemGroup>
</Project>
